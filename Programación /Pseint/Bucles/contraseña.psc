Algoritmo contraseña
	
	Definir num1 Como Entero
	Escribir "Escriba la contraseña"
	Escribir "Te quedan 3 intentos"
	Leer num1
	
	si (num1 = 352) o (num1 = 295) o (num1 = 569) Entonces
		Escribir "contraseña correcta"
	SiNo
		Definir num2 Como Entero
		Escribir "Escriba la contraseña"
		Escribir "Te quedan 2 intentos"
		Leer num2
		
		si (num2 = 352) o (num2 = 295) o (num2 = 569) Entonces
			Escribir "contraseña correcta"
		SiNo
			Definir num3 Como Entero
			Escribir "Escriba la contraseña"
			Escribir "Te quedan 1 intentos"
			Leer num3
			
			si (num3 = 352) o (num3 = 295) o (num3 = 569) Entonces
				Escribir "contraseña correcta"
				
			FinSi
			
			
		FinSi
		
		
	FinSi
	
	
	

	
	
	
	
	
	
FinAlgoritmo
