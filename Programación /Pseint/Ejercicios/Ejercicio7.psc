Algoritmo Ejericicio7
	Definir num1 Como Entero
	Escribir "Dame el precio del primer establecimiento"
	Leer num1
	
	Definir num2 Como Entero
	Escribir "Dame el precio del segundo establecimiento"
	Leer num2
	
	
	Definir num3 Como Entero
	Escribir "Dame el precio del tercer establecimiento"
	Leer num3
	
	resultado <- (num1+num2+num3)/3
	Mostrar "El resultado es: " resultado
	 
	
FinAlgoritmo
