Algoritmo Ejerciciointeraccion3
	Definir numero, doble Como Entero
	
	Escribir "Ingrese un número:"
	Leer numero
	
	Mientras numero >= 0
		doble = numero * 2
		Escribir "El doble de ", numero, " es ", doble
		Escribir "Ingrese un número:"
		Leer numero
	Fin Mientras
	
	Escribir "Ha ingresado un número menor que 0."
FinAlgoritmo
