<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>


<AnchorPane id="AnchorPane" prefHeight="400.0" prefWidth="600.0" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/23.0.1" fx:controller="controlador.PersonaVistaController">
   <children>
      <TableView fx:id="tblPersonas" layoutX="37.0" layoutY="23.0" prefHeight="302.0" prefWidth="527.0">
        <columns>
          <TableColumn fx:id="colNombre" prefWidth="186.0" text="Nombre" />
          <TableColumn fx:id="colApellidos" prefWidth="225.0" text="Apellidos" />
            <TableColumn fx:id="colEdad" prefWidth="115.0" text="Edad" />
        </columns>
      </TableView>
      <Button fx:id="btnAgregar" layoutX="57.0" layoutY="346.0" mnemonicParsing="false" onAction="#agregarPersona" prefHeight="26.0" prefWidth="140.0" text="Agregar persona" />
      <Button fx:id="btnModificar" layoutX="230.0" layoutY="346.0" mnemonicParsing="false" onAction="#modificar" prefHeight="26.0" prefWidth="140.0" text="Modificar persona" />
      <Button fx:id="btnEliminar" layoutX="405.0" layoutY="346.0" mnemonicParsing="false" onAction="#eliminar" prefHeight="26.0" prefWidth="140.0" text="Eliminar persona" />
   </children>
</AnchorPane>
