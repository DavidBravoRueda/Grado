Algoritmo Ejercico5
	
	Definir num1 Como Entero
	Escribir "Dame un número"
	Leer num1
	
	si num1 > 0 Entonces
		resultado1 <- num1 ^2
		resultado2 <- raiz(num1)
		Escribir "El cuadrado de " num1 " es " resultado1 " y la raiz cuadrada es " resultado2
		
	SiNo
		Escribir "ERROR"
	FinSi
	
FinAlgoritmo
