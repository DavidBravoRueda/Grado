Algoritmo Ejercicio2
	Definir num1 Como Entero
	Escribir "Dame un número"
	Leer num1
	
	
	Definir num2 Como Entero
	Escribir "Dame otro número"
	Leer num2
	
	Escribir "El rusultado de la suma de los dos numeros es: " num1 + num2
	Escribir "El rusultado de la resta de los dos numeros es: " num1 - num2
	Escribir "El rusultado de la multiplicación de los dos numeros es: " num1 * num2
	Escribir "El rusultado de la división de los dos numeros es: " num1 / num2
FinAlgoritmo
