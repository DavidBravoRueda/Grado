Algoritmo Ejercicio6
	
	Definir num1 Como Entero
	Escribir "Dime el número de niños"
	Leer num1
	
	Definir num2 Como Entero
	Escribir "Dime el número de niñas"
	Leer num2
	
	Total <- num1 + num2
	
	resultado1 <- (num1 * 100) / Total
	resultado2 <- (num2 * 100) / Total
	
	Escribir "Hay un " resultado1 "% de niños y un " resultado2 "% de niñas"

	
FinAlgoritmo
